root = true

[*.{cs,csx,vb}]
indent_style = space
indent_size = 4
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Underscores in identifiers: intentional for Given_When_Then test names.
dotnet_diagnostic.CA1707.severity = none

# API ViewModels: getters exist for JSON serialization (Presenter → HTTP).
[src/Api/ViewModels/**.cs]
resharper_unused_auto_property_accessor_global_highlighting = none

# Domain entities: private setters exist for EF Core materialization.
[src/Domain/**/Entities/**.cs]
resharper_unused_auto_property_accessor_local_highlighting = none
